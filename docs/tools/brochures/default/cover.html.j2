<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body>
  <div class="cover">
    <div class="cover-top">
      {% if doc.brand %}<div class="cover-brand">{{ doc.brand }}</div>{% endif %}
    </div>
    <div class="cover-middle">
      <h1 class="cover-title">{{ doc.title }}</h1>
      {% if doc.subtitle %}<h2 class="cover-subtitle">{{ doc.subtitle }}</h2>{% endif %}
      <div class="cover-version">Versão {{ doc.version }}</div>
    </div>
    <div class="cover-bottom">
      {% if doc.author %}<div class="cover-meta">Autor: {{ doc.author }}</div>{% endif %}
      <div class="cover-meta">{{ doc.date }}</div>
    </div>
  </div>
</body>
</html>
