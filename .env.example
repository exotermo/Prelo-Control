# Copy to .env and replace every development value before a non-local deployment.
# Generate a value with: openssl rand -base64 48
HERMES_GATEWAY_JWT_SECRET=replace-with-at-least-32-random-bytes
HERMES_GATEWAY_ISSUER=hermes-dev
HERMES_GATEWAY_AUDIENCE=llm-gateway
POSTGRES_PASSWORD=replace-with-a-random-password
