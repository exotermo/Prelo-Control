# Copy to .env and replace every development value before a non-local deployment.
# Generate a value with: openssl rand -base64 48
HERMES_GATEWAY_JWT_SECRET=replace-with-at-least-32-random-bytes
HERMES_GATEWAY_ISSUER=hermes-dev
HERMES_GATEWAY_AUDIENCE=llm-gateway
# Must match messaging-core's MESSAGING_JWT_SECRET for integration tokens accepted by hermes-go.
# Keep it separate from HERMES_GATEWAY_JWT_SECRET; never reuse the gateway secret.
HERMES_GO_API_JWT_SECRET=copy-the-messaging-core-jwt-secret-here
HERMES_GO_API_JWT_ISSUER=messaging-core
HERMES_GO_API_JWT_AUDIENCE=messaging-core
POSTGRES_PASSWORD=replace-with-a-random-password

# Fase G1: human login (password + mandatory TOTP) for hermes-dashboard.
# 32 random bytes, base64: openssl rand -base64 32
HERMES_GO_DASHBOARD_MFA_KEY=
# Gates POST /api/v1/admin/dashboard-invitations (creates/invites a dashboard user). Generate
# with: openssl rand -base64 32
HERMES_GO_ADMIN_TOKEN=
HERMES_GO_DASHBOARD_PUBLIC_URL=http://127.0.0.1:5176
HERMES_GO_DASHBOARD_SECURE_COOKIE=false
# Credentialed CORS allowlist (refresh/logout send credentials: "include" for the session
# cookie) — must be the dashboard's exact origin(s), never "*".
HERMES_GO_DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5176,http://localhost:5176
HERMES_GO_DASHBOARD_MAIL_FROM=dashboard@hermes.local
# Dev/local: point at the mailpit service in this compose (SMTP without auth/TLS, UI at
# http://127.0.0.1:8026). Production: use your real SMTP provider's credentials and set
# HERMES_GO_SMTP_AUTH/STARTTLS back to true.
HERMES_GO_SMTP_HOST=mailpit
HERMES_GO_SMTP_PORT=1025
HERMES_GO_SMTP_USER=
HERMES_GO_SMTP_PASSWORD=
HERMES_GO_SMTP_AUTH=false
HERMES_GO_SMTP_STARTTLS=false

# Fase G2: optional — lets hermes-dashboard's Configurações page manage
# hermes-messaging-bridge's owner-contacts list. Leave both empty to skip the integration.
# HERMES_BRIDGE_ADMIN_TOKEN must equal that service's own BRIDGE_ADMIN_TOKEN.
HERMES_BRIDGE_ADMIN_URL=http://hermes-messaging-bridge:8095
HERMES_BRIDGE_ADMIN_TOKEN=

# Fase S1: optional — lets the Servidores page register remote servers and SSH into them for
# health checks. Leave empty to skip the feature. Generate with: openssl rand -base64 32
# MUST be a different value than HERMES_GO_DASHBOARD_MFA_KEY above.
HERMES_GO_SERVER_CREDENTIALS_KEY=
# Fase I (optional): API keys + webhooks. 32 random bytes, base64 (openssl rand -base64 32),
# different from every other key above.
HERMES_GO_INTEGRATIONS_KEY=
# DEV ONLY — disables the webhook SSRF guard. Keep false outside a dev machine.
HERMES_GO_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Optional: only needed if you set GATEWAY_PROVIDER_ANTHROPIC_ENABLED=true. Leave empty to keep
# the Gateway on MockProvider. Never read by the app as an env var — Compose mounts it as a file
# at /run/secrets/anthropic_api_key inside llm-gateway only; Hermes never receives it.
ANTHROPIC_API_KEY=
GATEWAY_PROVIDER_ANTHROPIC_ENABLED=false

# Fase M: master key for provider API keys saved from the dashboard (sealed in llm-gateway).
# 32 random bytes, base64 (openssl rand -base64 32). Back it up: losing it means re-entering keys.
GATEWAY_CONNECTIONS_MASTER_KEY=
# DEV ONLY — lets an OpenAI-compatible base URL point at private/local addresses (e.g. Ollama).
GATEWAY_CONNECTIONS_ALLOW_PRIVATE_URLS=false

# Fase PA (optional): project files sealed at rest. 32 random bytes, base64 (openssl rand -base64 32),
# different from every other key. Back it up: losing it makes the stored files unreadable.
HERMES_GO_FILES_KEY=
