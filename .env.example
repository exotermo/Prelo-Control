# Copy to .env and replace every development value before a non-local deployment.
# Generate a value with: openssl rand -base64 48
HERMES_GATEWAY_JWT_SECRET=replace-with-at-least-32-random-bytes
HERMES_GATEWAY_ISSUER=hermes-dev
HERMES_GATEWAY_AUDIENCE=llm-gateway
# Must match messaging-core's MESSAGING_JWT_SECRET for integration tokens accepted by hermes-go.
# Keep it separate from HERMES_GATEWAY_JWT_SECRET; never reuse the gateway secret.
HERMES_GO_API_JWT_SECRET=copy-the-messaging-core-jwt-secret-here
HERMES_GO_API_JWT_ISSUER=messaging-core
HERMES_GO_API_JWT_AUDIENCE=messaging-core
POSTGRES_PASSWORD=replace-with-a-random-password

# Optional: only needed if you set GATEWAY_PROVIDER_ANTHROPIC_ENABLED=true. Leave empty to keep
# the Gateway on MockProvider. Never read by the app as an env var — Compose mounts it as a file
# at /run/secrets/anthropic_api_key inside llm-gateway only; Hermes never receives it.
ANTHROPIC_API_KEY=
GATEWAY_PROVIDER_ANTHROPIC_ENABLED=false
