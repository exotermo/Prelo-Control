# Copy to .env and replace every development value before a non-local deployment.
# Generate a value with: openssl rand -base64 48
PRELO_GATEWAY_JWT_SECRET=replace-with-at-least-32-random-bytes
PRELO_GATEWAY_ISSUER=prelo-dev
PRELO_GATEWAY_AUDIENCE=llm-gateway
# Must match messaging-core's MESSAGING_JWT_SECRET for integration tokens accepted by prelo-core.
# Keep it separate from PRELO_GATEWAY_JWT_SECRET; never reuse the gateway secret.
PRELO_API_JWT_SECRET=copy-the-messaging-core-jwt-secret-here
PRELO_API_JWT_ISSUER=messaging-core
PRELO_API_JWT_AUDIENCE=messaging-core
POSTGRES_PASSWORD=replace-with-a-random-password

# Fase G1: human login (password + mandatory TOTP) for prelo-dashboard.
# 32 random bytes, base64: openssl rand -base64 32
PRELO_DASHBOARD_MFA_KEY=
# Gates POST /api/v1/admin/dashboard-invitations (creates/invites a dashboard user). Generate
# with: openssl rand -base64 32
PRELO_ADMIN_TOKEN=
PRELO_DASHBOARD_PUBLIC_URL=http://127.0.0.1:5176
PRELO_DASHBOARD_SECURE_COOKIE=false
# Credentialed CORS allowlist (refresh/logout send credentials: "include" for the session
# cookie) — must be the dashboard's exact origin(s), never "*".
PRELO_DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5176,http://localhost:5176
PRELO_DASHBOARD_MAIL_FROM=dashboard@prelo.local
# Dev/local: point at the mailpit service in this compose (SMTP without auth/TLS, UI at
# http://127.0.0.1:8026). Production: use your real SMTP provider's credentials and set
# PRELO_SMTP_AUTH/STARTTLS back to true.
PRELO_SMTP_HOST=mailpit
PRELO_SMTP_PORT=1025
PRELO_SMTP_USER=
PRELO_SMTP_PASSWORD=
PRELO_SMTP_AUTH=false
PRELO_SMTP_STARTTLS=false

# Fase G2: optional — lets prelo-dashboard's Configurações page manage
# prelo-messaging-bridge's owner-contacts list. Leave both empty to skip the integration.
# PRELO_BRIDGE_ADMIN_TOKEN must equal that service's own BRIDGE_ADMIN_TOKEN.
PRELO_BRIDGE_ADMIN_URL=http://prelo-messaging-bridge:8095
PRELO_BRIDGE_ADMIN_TOKEN=

# Fase S1: optional — lets the Servidores page register remote servers and SSH into them for
# health checks. Leave empty to skip the feature. Generate with: openssl rand -base64 32
# MUST be a different value than PRELO_DASHBOARD_MFA_KEY above.
PRELO_SERVER_CREDENTIALS_KEY=
# Fase I (optional): API keys + webhooks. 32 random bytes, base64 (openssl rand -base64 32),
# different from every other key above.
PRELO_INTEGRATIONS_KEY=
# DEV ONLY — disables the webhook SSRF guard. Keep false outside a dev machine.
PRELO_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Optional: only needed if you set GATEWAY_PROVIDER_ANTHROPIC_ENABLED=true. Leave empty to keep
# the Gateway on MockProvider. Never read by the app as an env var — Compose mounts it as a file
# at /run/secrets/anthropic_api_key inside llm-gateway only; Prelo never receives it.
ANTHROPIC_API_KEY=
GATEWAY_PROVIDER_ANTHROPIC_ENABLED=false

# Fase M: master key for provider API keys saved from the dashboard (sealed in llm-gateway).
# 32 random bytes, base64 (openssl rand -base64 32). Back it up: losing it means re-entering keys.
GATEWAY_CONNECTIONS_MASTER_KEY=
# DEV ONLY — lets an OpenAI-compatible base URL point at private/local addresses (e.g. Ollama).
GATEWAY_CONNECTIONS_ALLOW_PRIVATE_URLS=false

# Fase PA (optional): project files sealed at rest. 32 random bytes, base64 (openssl rand -base64 32),
# different from every other key. Back it up: losing it makes the stored files unreadable.
PRELO_FILES_KEY=

# Isolated task executor. Keep disabled on the Prelo control-plane host until a dedicated VM
# is provisioned and validated. The worker has separate PRELO_WORKER_ENABLE_RUNTIME/Image vars.
PRELO_EXECUTOR_ENABLED=false

# G11 (optional): push to the Work Control app. Absolute host path of the Firebase service-account
# JSON (Firebase console → Project settings → Service accounts → Generate new private key). Keep it
# outside the repo (e.g. ~/.config/prelo/fcm-service-account.json, chmod 644 inside a chmod 700 dir).
# Unset = push off.
PRELO_FCM_SERVICE_ACCOUNT_FILE=

# Fase X: shared token between llm-gateway and cli-runner (openssl rand -hex 32).
PRELO_CLI_RUNNER_TOKEN=
