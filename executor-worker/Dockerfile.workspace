FROM golang:1.26.5-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY internal/workspace ./internal/workspace
COPY cmd/workspace-helper ./cmd/workspace-helper
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /workspace-helper ./cmd/workspace-helper
RUN mkdir -p /src/empty-workspace /src/empty-tmp

FROM scratch
COPY --from=build /workspace-helper /workspace-helper
COPY --from=build --chown=10001:10001 /src/empty-workspace /workspace
COPY --from=build --chown=10001:10001 /src/empty-tmp /tmp
USER 10001:10001
ENTRYPOINT ["/workspace-helper"]
