PRELO_BASE_URL=https://prelo.example.invalid
PRELO_EXECUTOR_TOKEN=prw_REPLACE_WITH_ONE_TIME_TOKEN_FROM_ADMIN_API
# Runtime is opt-in and should only be enabled on the dedicated executor VM.
PRELO_WORKER_ENABLE_RUNTIME=false
# Keep Podman images and executor state off the root filesystem. Create this directory
# beforehand and make it writable only by the restricted worker account.
PRELO_WORKER_DATA_DIR=/mnt/storage/prelo-executor
# When enabled, use a local image name pinned to this registered sha256 digest.
PRELO_WORKER_IMAGE=localhost/prelo-workspace@sha256:REPLACE_WITH_64_HEX_DIGEST
# Host capacity preserved for Debian, CasaOS, backups, and Prelo.
PRELO_WORKER_MEMORY_RESERVE_BYTES=1610612736
PRELO_WORKER_CPU_RESERVE=1.0
PRELO_WORKER_DISK_RESERVE_BYTES=5368709120
PRELO_WORKER_PIDS_RESERVE=128
# Conservative per-container profile and initial concurrency ceiling.
PRELO_WORKER_MAX_CONTAINERS=1
PRELO_WORKER_CONTAINER_MEMORY_BYTES=268435456
PRELO_WORKER_CONTAINER_CPUS=0.5
PRELO_WORKER_CONTAINER_DISK_BYTES=1073741824
PRELO_WORKER_CONTAINER_PIDS=64
