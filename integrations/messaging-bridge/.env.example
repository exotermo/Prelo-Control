MESSAGING_CORE_URL=http://messaging-core:8090
MESSAGING_CORE_CLIENT_ID=
MESSAGING_CORE_CLIENT_SECRET=
CALLBACK_SIGNING_SECRET=
HERMES_APP_URL=http://hermes-app-go:8080
# Fail closed. Set true only after explicitly reviewing the target contacts.
BRIDGE_AUTO_REPLY_ENABLED=false
BRIDGE_ADMIN_TOKEN=
# E.164 numbers (comma-separated), the only senders routed to the "general" agent (full tool
# capabilities). Every other sender gets "customer" (no capabilities). Empty = everyone is
# treated as a customer.
BRIDGE_OWNER_CONTACTS=
BRIDGE_DB_PASSWORD=
# Callback contract v2 is required by default: HMAC(secret, timestamp + "." + raw body),
# plus a durable unique X-Webhook-Id replay key.
BRIDGE_CALLBACK_REPLAY_TOLERANCE_SECONDS=300
BRIDGE_ALLOW_LEGACY_CALLBACK_SIGNATURES=false
